# ECHODESK Backend Configuration
# Copy to .env for local overrides (never commit secrets)

PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Optional: Cloud AI Provider (Leave blank for deterministic 100% offline mode)
GEMINI_API_KEY=

# Privacy Policy Defaults
ALLOW_CLOUD_REASONING=true
ALLOW_CROSS_DEVICE_HANDOFF=true
ENFORCE_STRICT_ZERO_SURVEILLANCE=true
